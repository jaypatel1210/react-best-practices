{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true
  },
  "include": ["skills/**/assets/**/*.ts", "skills/**/assets/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts", "eslint.config.js"]
}
