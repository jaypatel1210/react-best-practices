---
/** A link to a skill page by skill name, e.g. <SkillLink name="react-effects" />. */
import { getEntry } from 'astro:content';
import { skillUrl } from '../lib/urls';

interface Props {
  name: string;
}

const { name } = Astro.props;
const entry = await getEntry('skills', name);
if (!entry) throw new Error(`<SkillLink name="${name}"> points to a skill that doesn't exist.`);
const hasText = Astro.slots.has('default');
---

<a href={skillUrl(name)}>{hasText ? <slot /> : <code>{name}</code>}</a>
