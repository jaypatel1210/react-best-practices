---
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const commands = `${SITE.install.marketplace}\n${SITE.install.plugin}`;
---

<div class="terminal">
  <div class="terminal-head">
    <i></i><i></i><i></i>
    <span>Claude Code</span>
    <button class="copy-button" type="button" data-copy={commands} aria-label="Copy install commands">
      <Icon name="copy" /><span>Copy</span>
    </button>
  </div>
  <pre>{!compact && <span class="comment"># In Claude Code, add the marketplace, then install the plugin{'\n'}</span>}<span class="prompt">› </span>{SITE.install.marketplace}{'\n'}<span class="prompt">› </span>{SITE.install.plugin}</pre>
</div>
