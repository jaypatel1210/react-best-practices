---
import { SITE } from '../config';
import { graph, siteGraph } from '../lib/seo';
import { absoluteUrl, ogImageUrl, url } from '../lib/urls';

export interface SeoProps {
  /** Page title without the site name. */
  title: string;
  description: string;
  /** Key of the Open Graph image under /og/. Defaults to "home". */
  og?: string;
  type?: 'website' | 'article';
  /** Append " | React Best Practices" to the title. */
  suffix?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page; the site graph is always included. */
  schema?: Record<string, unknown>[];
  article?: { published: Date; updated?: Date; section: string; tags: string[] };
}

const {
  title,
  description,
  og = 'home',
  type = 'website',
  suffix = true,
  noindex = false,
  schema = [],
  article,
} = Astro.props as SeoProps;

// Search results cut titles at about 60 characters, so add the site name only when it fits.
const withName = `${title} | ${SITE.name}`;
const fullTitle = suffix && withName.length <= 62 ? withName : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;
const image = absoluteUrl(ogImageUrl(og), Astro.site);
const jsonLd = graph([...siteGraph(Astro.site), ...schema]);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
<meta name="author" content={SITE.author.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />
      <meta property="article:section" content={article.section} />
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/manifest.webmanifest')} />
<link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name}: new fixes`} href={url('/rss.xml')} />

<script type="application/ld+json" set:html={jsonLd} />
