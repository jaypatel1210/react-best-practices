---
import { url } from '../lib/urls';
import Icon from './Icon.astro';
---

<dialog class="search-dialog" aria-label="Search the site" data-index={url('/search-index.json')}>
  <div class="search-panel">
    <div class="search-box">
      <Icon name="search" />
      <input
        type="search"
        placeholder="Describe the symptom: “input loses focus”, “effect loops”…"
        aria-label="Search fixes, skills and utilities"
        aria-controls="search-results"
        aria-autocomplete="list"
        role="combobox"
        aria-expanded="true"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="search-close" data-search-close aria-label="Close search"><kbd>Esc</kbd></button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Results"></ul>
    <p class="search-empty" hidden>
      No matches yet. Try other words, or <a href={url('/fixes/')}>browse every fix</a>.
    </p>
    <div class="search-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>Enter</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    width: min(680px, calc(100vw - 24px));
    max-height: min(640px, calc(100dvh - 48px));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgb(8 10 20 / 0.5);
    backdrop-filter: blur(3px);
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }

  .search-box > svg {
    width: 20px;
    height: 20px;
    color: var(--text-3);
    flex: none;
  }

  .search-box input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1.05rem;
  }

  .search-box input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search-results:empty {
    display: none;
  }

  .search-results a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    padding: 10px 12px;
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .search-results [aria-selected='true'] a {
    background: var(--brand-soft);
  }

  .search-results .r-type {
    grid-row: span 2;
    align-self: start;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
    min-width: 64px;
  }

  .search-results .r-title {
    font-weight: 600;
    line-height: 1.35;
  }

  .search-results .r-desc {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-results mark {
    background: transparent;
    color: var(--brand);
    font-weight: 700;
  }

  .search-empty {
    padding: 28px 20px;
    color: var(--text-2);
    text-align: center;
  }

  .search-foot {
    display: flex;
    gap: 18px;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-3);
    font-size: 0.8rem;
  }

  .search-foot kbd + kbd {
    margin-left: 3px;
  }

  @media (max-width: 560px) {
    .search-dialog {
      margin-top: 12px;
    }
    .search-foot {
      display: none;
    }
  }
</style>

<script>
  interface Entry {
    t: string;
    d: string;
    u: string;
    k: string;
    g: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const empty = dialog.querySelector<HTMLElement>('.search-empty')!;
  let index: Entry[] | null = null;
  let active = -1;
  let opener: HTMLElement | null = null;

  async function loadIndex(): Promise<Entry[]> {
    if (index) return index;
    const response = await fetch(dialog.dataset.index!);
    index = (await response.json()) as Entry[];
    return index;
  }

  const escapeHtml = (text: string) =>
    text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function highlight(text: string, terms: string[]): string {
    let html = escapeHtml(text);
    for (const term of terms) {
      if (term.length < 2) continue;
      const pattern = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig');
      html = html.replace(pattern, '<mark>$1</mark>');
    }
    return html;
  }

  function score(entry: Entry, terms: string[]): number {
    const title = entry.t.toLowerCase();
    const desc = entry.d.toLowerCase();
    const tags = entry.g.toLowerCase();
    let total = 0;
    for (const term of terms) {
      const inTitle = title.includes(term);
      const inTags = tags.includes(term);
      const inDesc = desc.includes(term);
      if (!inTitle && !inTags && !inDesc) return 0;
      total += (inTitle ? 4 : 0) + (inTags ? 2 : 0) + (inDesc ? 1 : 0);
      if (title.startsWith(term)) total += 2;
    }
    return total;
  }

  function setActive(next: number) {
    const items = list.querySelectorAll<HTMLLIElement>('li');
    if (!items.length) return;
    active = (next + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    const current = items[active];
    input.setAttribute('aria-activedescendant', current.id);
    current.scrollIntoView({ block: 'nearest' });
  }

  async function render() {
    const query = input.value.trim().toLowerCase();
    const entries = await loadIndex();
    const terms = query.split(/\s+/).filter(Boolean);
    const results = terms.length
      ? entries
          .map((entry) => ({ entry, s: score(entry, terms) }))
          .filter((r) => r.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 12)
          .map((r) => r.entry)
      : entries.filter((e) => e.k === 'Fix').slice(0, 8);

    list.innerHTML = results
      .map(
        (entry, i) => `<li id="sr-${i}" role="option" aria-selected="false"><a href="${entry.u}" tabindex="-1">
          <span class="r-type">${escapeHtml(entry.k)}</span>
          <span class="r-title">${highlight(entry.t, terms)}</span>
          <span class="r-desc">${highlight(entry.d, terms)}</span></a></li>`,
      )
      .join('');
    empty.hidden = results.length > 0;
    active = -1;
    input.removeAttribute('aria-activedescendant');
    if (results.length) setActive(0);
  }

  function open() {
    if (dialog.open) return;
    opener = document.activeElement as HTMLElement | null;
    dialog.showModal();
    input.select();
    void render();
  }

  input.addEventListener('input', () => void render());

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === 'Enter') {
      const link = list.querySelectorAll('a')[active];
      if (link) {
        event.preventDefault();
        window.location.href = link.href;
      }
    }
  });

  dialog.addEventListener('close', () => opener?.focus());

  // Close when the backdrop (the dialog element itself, outside the panel) is clicked.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());

  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open));

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
    if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });
</script>
