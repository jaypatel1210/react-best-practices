---
/** The site mark: a rounded tile holding a check between two code brackets. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="#5546e8"></rect>
  <path
    d="M10.5 10.5 6 16l4.5 5.5M21.5 10.5 26 16l-4.5 5.5"
    fill="none"
    stroke="#fff"
    stroke-opacity="0.75"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="m12.6 16.4 2.6 2.7 4.4-6"
    fill="none"
    stroke="#7dfcc6"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
