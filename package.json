{
  "name": "react-best-practices-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Maintainer tooling for the react-best-practices skills: type-checks and tests the code shipped in skills/*/assets, and tests the react-render-audit plugin.",
  "author": "Jay Patel (https://github.com/jaypatel1210)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaypatel1210/react-best-practices.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "test": "vitest run",
    "test:render-audit": "vitest run --config plugins/react-render-audit/vitest.config.mjs",
    "e2e:render-audit": "node plugins/react-render-audit/tests/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "claude plugin validate --strict .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:render-audit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "web-vitals": "^6.2.2"
  }
}
